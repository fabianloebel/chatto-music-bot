# Required ---------------------------------------------------------------
# API key of the bot account (Server Admin -> Bots -> your bot -> API keys)
CHATTO_BOT_TOKEN=
# Base URL of your Chatto server
CHATTO_URL=https://chat.example.com
# Public LiveKit URL used for calls (same as CHATTO_LIVEKIT_URL on the server)
LIVEKIT_URL=wss://livekit.chat.example.com

# Optional (defaults shown) ----------------------------------------------
# ALONE_GRACE_MS=20000      # leave the call this long after the last human left
# IDLE_MS=300000            # leave after this long with nothing playing
# MAX_TRACK_SEC=1800        # reject longer tracks (live streams are allowed)
# MAX_QUEUE=50              # max queue length per room
# REQUIRE_LISTENER=true     # only people in the call may control playback
# SMART_SEARCH=true         # prefer studio versions over live/cover/remix uploads
# AUTOJOIN_MS=60000         # how often to join newly created rooms
# DATA_FILE=/data/state.json  # saved queues and favorites
